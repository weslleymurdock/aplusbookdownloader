            "text": "/*body {\r\n  counter-reset: section tacio; *//* Define e reseta os dois contadores*/\r\n/*}\r\n*/\r\n\r\nh3.algetec_h3.reset {\r\n  counter-reset: section; /* Reinicia o contador a partir deste h3 */\r\n}\r\n\r\nh3.algetec_h3:nth-of-type(n)::before {\r\n  counter-increment: section; /* Incrementa o contador para cada h3 */\r\n  content: counter(section) \". \"; /* Mostra o contador antes do texto do h3 */\r\n}\r\nh2.algetec_h2.reset {\r\n  counter-reset: tacio; /* Reinicia o contador a partir deste h2 */\r\n}\r\n\r\nh2.algetec_h2:nth-of-type(n + 3)::before {\r\n  /* Add any other CSS properties you want to modify */\r\n  counter-increment: tacio; /* Incrementa o contador para cada h2 */\r\n  content: counter(tacio) \". \"; /* Mostra o contador antes do texto do h2 */\r\n}\r\n\r\n\r\nh3.algetec_h3 {\r\n  margin: 16px 0px 0px;\r\n  text-align: justify;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  line-height: 150%;\r\n  font-size: 1rem;\r\n  margin: 0px 0px 0px 24px;\r\n\r\n}\r\nh3.algetec_a_h3 {\r\n  margin: 16px 0px 0px;\r\n  text-align: justify;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  line-height: 150%;\r\n  font-size: 1rem;\r\n  margin: 0px 0px 0px 24px;\r\n\r\n}\r\n\r\nh2.algetec_a_h2 {\r\n  text-align: justify;\r\n  line-height: 150%;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  margin: 0px 0px 11px 24px;\r\n  font-size: 1.5rem;\r\n}\r\n\r\n\r\nh2.algetec_h2 {\r\n  text-align: justify;\r\n  line-height: 150%;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  margin: 0px 0px 11px 24px;\r\n  font-size: 1.5rem;\r\n}\r\n\r\nh1.algetec_h1 {\r\n  text-align: center;\r\n  line-height: 150%;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  margin: 0px 0px 11px;\r\n  font-size: 2rem;\r\n}\r\n\r\np.algetec_p {\r\n  margin: 16px 0px 11px 48px;\r\n  text-align: justify;\r\n  line-height: 150%;\r\n  font-size: 1rem;\r\n  font-family: 'Lato', arial, sans-serif !important;\r\n}\r\n\r\nimg.algetec_img {\r\n  display: block;\r\n  max-width: 75%;\r\n  height: auto;\r\n  margin: 0 auto;\r\n}\r\n\r\n\r\nspan.algetec_span {\r\n  font-family: arial, 'Lato', sans-serif !important;\r\n}\r\n\r\nul.algetec_ul {\r\n  list-style-type: '.  ';\r\n  line-height: 150%;\r\n}\r\n\r\nul.algetec_ul>li.algetec_li::marker {\r\n  color: #bb243e;\r\n}\r\n\r\nli.algetec_li {\r\n  font-family: 'Lato', arial, sans-serif !important;\r\n\r\n}\r\n\r\nli.algetec_li>* {\r\n  text-indent: -24px;\r\n}\r\n\r\n.procedments-list-item {\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e; \r\n  font-size: 1.5rem;\r\n}\r\n\r\nli.algetec_li>p.algetec_p {\r\n  text-align: justify;\r\n  line-height: 150%;\r\n  font-family: Bahnschrift, sans-serif;\r\n  text-indent: -24px;\r\n  font-size: 1rem; \r\n}\r\n\r\nli.algetec_li>h3.algetec_h3 {\r\n  color: #222;\r\n  counter-increment: item;\r\n  list-style-type: none;\r\n}\r\n\r\n.subtitle.algetec_subtitle {\r\n  text-align: justify;\r\n  line-height: 150%;\r\n  break-after: avoid;\r\n  font-family: Bahnschrift, sans-serif;\r\n  color: #bb243e;\r\n  margin: 0px 0px 11px;\r\n  font-size: 1.5rem;\r\n}\r\n\r\n.algetec-platform-componentes-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2rem;\r\n  padding: 2rem 0;\r\n}\r\n\r\n.algetec-component-title {\r\n  border-bottom: 0.125rem solid #0779e4;\r\n  color: #004784;\r\n  font-family: 'trebuchet ms', geneva, sans-serif;\r\n  font-size: 1.875rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  line-height: 2.25rem;\r\n  width: 100%;\r\n  margin: 0;\r\n}\r\n\r\n.algetec-header-title {\r\n  padding: 1.5rem;\r\n  background: linear-gradient(132deg, #1e79d3 8.61%, #4da6ff 95.09%), #4da6ff;\r\n\r\n  color: #faf9f6;\r\n  text-align: center;\r\n\r\n  font-family: 'trebuchet ms', geneva, sans-serif;\r\n  font-size: 2rem;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.algetec-flex-col-gap {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.75rem;\r\n}\r\n\r\n.algetec-center {\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.algetec-component-text {\r\n  color: #666;\r\n  font-family: 'Lato', sans-serif;\r\n  font-size: 1.375rem;\r\n  font-style: normal;\r\n  font-weight: 400;\r\n  line-height: 2.25rem;\r\n}\r\n\r\n.algetec-component-text p {\r\n  margin: 0;\r\n}\r\n\r\n.algetec-box-shadow-card {\r\n  padding: 1.5rem;\r\n  box-shadow: rgba(0, 0, 0, 0.25) 0 0.25rem 0.25rem, rgba(0, 0, 0, 0.25) 0 0.75rem 0.75rem;\r\n  border-radius: 0.5rem;\r\n}\r\n\r\n.algetec-bg-gold {\r\n  background: rgba(227, 188, 82, 0.2);\r\n}\r\n\r\n.algetec-bg-green {\r\n  background: rgba(17, 193, 108, 0.2);\r\n}\r\n\r\n.algetec-component-subtitle {\r\n  padding-top: 0.5rem;\r\n  color: #004784;\r\n  text-align: right;\r\n  font-family: 'trebuchet ms', geneva, sans-serif;\r\n  font-size: 1.375rem;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  letter-spacing: 0.25rem;\r\n}\r\n\r\n.algetec-notification {\r\n  box-shadow: 0rem 0.5625rem 0.5rem rgba(108, 59, 1, 0.22);\r\n  border-width: 0.125rem;\r\n  border-style: solid;\r\n  display: flex;\r\n  max-width: 35rem;\r\n  padding: 0.5rem 0.75rem;\r\n  margin: 0.625rem 1.125rem;\r\n  align-items: center;\r\n  gap: 0.625rem;\r\n  border-radius: 0.5rem;\r\n}\r\n\r\n.algetec-notification.alert {\r\n  border-color: #6c3b01;\r\n  background: linear-gradient(0deg, rgba(250, 211, 128, 0.86) 0%, rgba(250, 211, 128, 0.86) 100%), #fff;\r\n  color: #6c3b01;\r\n}\r\n\r\n.algetec-notification.success {\r\n  border-color: #004641;\r\n  background: linear-gradient(0deg, rgba(128, 208, 194, 0.5) 0%, rgba(128, 208, 194, 0.5) 100%), #fff;\r\n  color: #004641;\r\n}\r\n\r\n.algetec-notification.info {\r\n  border-color: #0062b5;\r\n  background: linear-gradient(0deg, rgba(233, 246, 255, 1) 0%, rgba(233, 246, 255, 1) 100%), #fff;\r\n  color: #0062b5;\r\n}\r\n\r\n.algetec-notification-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.algetec-notification-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 0.5rem;\r\n  padding: 0.8125rem 0.625rem;\r\n  flex: 1 0 0;\r\n\r\n  /* Typography */\r\n  font-family: 'Lato', sans-serif;\r\n  font-size: 1.375rem;\r\n  font-weight: 800;\r\n  line-height: 1.5rem;\r\n  letter-spacing: 0.0156rem;\r\n}\r\n\r\n.algetec-notification-content p {\r\n  font-weight: 400;\r\n  line-height: 2.25rem;\r\n  margin: 0;\r\n}\r\n.algetec-platform-media-grid {\r\n  display: flex;\r\n  padding: 1rem;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  gap: 1rem;\r\n}\r\n\r\n.algetec-platform-media-grid img {\r\n  border-radius: 0.5rem;\r\n}\r\n\r\n.algetec-platform-media-grid figcaption {\r\n  padding-top: 0.5rem;\r\n  color: #666;\r\n  text-align: center;\r\n  font-family: 'Lato', sans-serif;\r\n  font-size: 1.125rem;\r\n  font-style: normal;\r\n  font-weight: 400;\r\n  line-height: 1.25rem;\r\n  letter-spacing: 0.125rem;\r\n}\r\n\r\n.algetec-image-component {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.algetec-image-component img {\r\n  max-width: calc(100dvw - 5rem);\r\n}\r\n\r\n.algetec-image-component figcaption {\r\n  text-align: center;\r\n  color: #666;\r\n  font-family: 'Lato', sans-serif;\r\n  font-size: 1.125rem;\r\n  font-style: normal;\r\n  font-weight: 400;\r\n  line-height: 130%;\r\n  letter-spacing: 0.125rem;\r\n}\r\n\r\n@media screen and (min-width: 48rem) {\r\n  .algetec-platform-componentes-container {\r\n    max-width: calc(70vw - 5rem);\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .algetec-platform-media-grid {\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .algetec-platform-media-grid figure {\r\n    padding: 0;\r\n  }\r\n\r\n  .algetec-image-component img {\r\n    max-width: calc(50dvw - 5rem);\r\n  }\r\n}"
