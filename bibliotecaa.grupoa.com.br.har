            "text": "{\n  \"closeBtn\": \"Fechar << Diálogo >>\",\n  \"a11yBtn\": {\n    \"txt\": \"Acessibilidade\",\n    \"tip\": \"Abra o menu de opções de acessibilidade\",\n    \"drag\": \"Explore suas opções de acessibilidade\"\n  },\n  \"blindNotif\": {\n    \"note\": \"Observação: este site inclui um sistema de acessibilidade.\",\n    \"keys\": \"Pressione Control-F11 para ajustar o site para pessoas com deficiências visuais que usam um leitor de tela; Pressione Control-F10 para abrir um menu de acessibilidade.\"\n  },\n  \"shortcuts\": {\n    \"a11yMenu\": \"Pressione Enter para acessar o menu de acessibilidade\",\n    \"a11yMenuMobile\": \"Pressione para acessar o menu\",\n    \"blind\": {\n      \"txt\": \"Pressione Enter para acessar acessibilidade para pessoas cegas\",\n      \"mobileTxt\": \"Imprensa para acessibilidade para pessoas cegas\",\n      \"sup\": \" que usam leitores de tela\"\n    },\n    \"keyboard\": \"Pressione Enter para Navegação pelo Teclado\"\n  },\n  \"freemsg\": {\n    \"msg1\": \"Versão limitada, solução gratuita.\",\n    \"msg2\": \"Saber mais\"\n  }\n}"
