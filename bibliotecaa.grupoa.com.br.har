            "text": "*{\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n    -webkit-font-smoothing: antialiased;\n}\n\nul{\n    list-style: none;\n}\n\na{\n    text-decoration: none;\n}\n\nbody{\n    font-family: Lato, sans-serif;\n    font-size: 0.875rem;\n\n    background-color: #F8F9FA;\n}\n\n/* \n\n    Header \n\n*/\n\nheader{\n    padding: 1.875rem 1.125rem;\n\n    background-color: #fff;\n    box-shadow: 0px 10px 25px 0px #E0E0E0;\n}\n\n.header-container{\n    max-width: 1200px;\n    /* padding: 0 1rem; */\n    margin: 0 auto;\n\n    display: flex;\n    justify-content: space-between;\n}\n\ni.nav-icon{\n    display: none;\n    cursor: pointer;\n    font-size: 1.5rem;\n}\n\n.nav-logo{\n    display: flex;\n    align-items: center;\n    gap: 0.25rem;\n}\n\n.nav-logo img{\n    width: 188px;\n}\n\n.header-container > nav {\n    display: flex;\n    align-items: center;\n    gap: 1.625rem;\n}\n\n.header-container > nav > .nav-list{\n    display: flex;\n    gap: 0.625rem;\n\n    background-color: #fff;\n}\n\nnav > .nav-list > li{\n    padding: 0.5rem;\n}\n\nnav > .nav-list > li > a{\n    color: #000;\n    font-weight: 700;\n    font-size: 1rem;\n}\n\nnav > .nav-list > li:nth-child(1) > a{\n    color: #BB243E;\n}\n\n\n\n.nav-main-button{\n    padding: 1rem;\n    color: #fff;\n    font-weight: 600;\n    background-color: #BB243E;\n    border-radius: 3px;\n}\n\n.nav-list > li > a > img{\n    display: none;\n}\n\n@media screen and (max-width: 1220px){\n\n    .nav-logo img{\n        width: 136px;\n    }\n\n    i.nav-icon{\n        display: inline-block;\n        padding: 0.5rem;\n    }\n\n    .header-container > nav > .nav-list{\n        width: 240px;\n        padding: 1rem;\n        display: none;\n        \n        flex-direction: column;\n        gap: 1.875rem;\n\n        position: absolute;\n        left: 0;\n        top: 100px;\n        z-index: 2;\n\n        box-shadow: 0px 10px 25px 0px #E0E0E0;\n    }\n\n    .nav-list > li > a{\n        display: flex;\n        align-items: center;\n        gap: 1rem;\n\n        color: #3A4E5D;\n        font-size: 1rem;\n    }\n\n    .nav-list > li > a > img{\n        display: block;\n        width: 1.5rem;\n        height: 1.625rem;\n    }\n}\n\n/* \n\n    Main \n\n*/\n\n/* main{\n    padding: 3.75rem 0;\n} */\n\n.main-container{\n    max-width: 1200px;\n    padding: 6rem 1rem;\n    /* min-height: 440px; */\n    margin: 0 auto;\n\n    position: relative;\n\n    background: url(\"../img/boasvindas/main.png\");\n    background-repeat: no-repeat;\n    background-position: center right;\n    background-size: 600px;\n}\n\n.main-wrapper{ \n    display: flex;\n    /* min-height: 440px; */\n}\n\n.main-content{\n    /* min-height: 440px; */\n    max-width: 40%;\n    /* padding: 3.75rem 0; */\n    /* margin-top: -3.75rem; */\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 1.125rem;\n}\n\n.main-content > span{\n    font-family: Poppins, sans-serif;\n    font-size: 1.5rem;\n    font-weight: 600;\n}\n\n.main-content > h1{\n    font-family: Poppins, sans-serif;\n    font-size: 2.5rem;\n    font-weight: 700;\n}\n\n.main-content > p{\n    font-family: Lato, sans-serif;\n    font-size: 1rem;\n    font-weight: 700;\n}\n\n/* .main-img{\n    max-width: 100%;\n} */\n\n.main-button{\n    width: fit-content;\n    padding: 1rem;\n    /* margin-top: calc(-3.5rem + 1.5rem); */\n\n    /* position: absolute;\n    bottom: 56px; */\n\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n\n    background-color: #BB243E;\n    color: #fff;\n    border-radius: 3px;\n\n    font-size: 1.375rem;\n}\n\n.main-button > i {\n    font-size: 24px; \n    padding-top: 3px;\n}\n\n.main-button-mobile{\n    display: none;\n    /* margin: 0 1rem; */\n    margin-top: 3rem;\n    width: 100%;\n    text-align: center;\n}\n\n@media screen and (max-width: 1220px){\n    /* .main-container{\n        padding-left: 1rem;\n        padding-right: 1rem;\n    } */\n\n    /* .main-content{\n        max-width: 70%;\n    } */\n    /* .main-img{\n        width: 456px;\n    } */\n    \n}\n\n@media screen and (max-width: 1060px){\n\n    /* .main-container{\n        padding: 2rem 1rem;\n    } */\n\n    .main-container{\n        background-image: url(\"../img/boasvindas/main-mobile.png\");\n        background-position: top right;\n        background-size: auto 440px;\n    }\n\n    .main-button-desktop{\n        display: none;\n    }\n\n    .main-button-mobile{\n        display: block;\n        margin-top: 3rem;\n    }\n\n    /* .main-button{\n        position: initial;\n    } */\n}\n\n@media screen and (max-width: 900px){\n    .main-container{\n        background-size: auto 360px;\n        padding: 3rem 1rem;\n    } \n\n    .main-button-mobile{\n        margin-top: 3rem;\n    }\n\n}\n\n@media screen and (max-width: 768px){\n    .main-container{\n        background-size: auto 360px;\n        padding: 6rem 1rem;\n    } \n\n    .main-content{\n        max-width: 50%;\n        margin: 0;\n    }\n\n    .main-content > span{\n        font-size: 1rem;\n    }\n\n    .main-content > h1{\n        font-size: 1.25rem;\n    }\n\n    .main-content > p{\n        font-size: 0.875rem;\n    }\n\n    .main-button-mobile{\n        margin-top: 6rem;\n    }\n\n}\n\n@media screen and (max-width: 480px){\n    .main-button-mobile{\n        margin-top: 2rem;\n    }\n    \n    .main-container{\n        background-size: auto 260px;\n        padding: 3rem 1rem;\n    } \n}\n\n@media screen and (max-width: 375px){\n\n    .main-container{\n        background-size: auto 240px;\n        padding: 2rem 1rem;\n    } \n}\n\n/* \n\n    Downloads \n\n*/\n\nsection.downloads{\n    background-color: #fff;\n    padding: 3rem 0;\n}\n\n.downloads-container{\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1rem;\n}\n\n.downloads-container > h2{\n    font-weight: 900;\n    font-size: 1.5rem;\n    margin-bottom: 0.5rem;\n}\n\n.downloads-container > p{\n    font-weight: 400;\n    font-size: 0.875rem;\n    margin-bottom: 1.5rem;\n}\n\n.downloads-wrapper{\n    display: flex;\n    justify-content: space-around;\n}\n\n.downloads-content{\n    display: flex;\n    align-items: center;\n    gap: 2rem;\n}\n\n.downloads-illustration{\n    max-width: 16.875rem;\n}\n\n.downloads-icons{\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 1.5rem;\n}\n\n.downloads-icons > a{\n    height: fit-content;\n    width: fit-content;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.download-icon{\n    width: 160px;\n}\n\n@media screen and (max-width: 1220px) {\n    /* .downloads-container{\n     padding: 0 1rem;\n    } */\n }\n\n@media screen and (max-width: 1060px){\n\n    .downloads-container > h2{\n        text-align: center;\n    }\n\n    .downloads-container > p{\n        text-align: center;\n        font-size: 0.625rem;\n    }\n\n    .downloads-wrapper{\n        flex-direction: column;\n        justify-content: start;\n        align-items: center;\n        gap: 1.5rem;\n    }\n\n    .downloads-illustration{\n        display: none;\n    }\n}\n\n/* \n\n    Footer \n\n*/\n\nfooter{\n    background-color: #000;\n    border-bottom: 4px solid #D51030;\n}\n\n.footer-container{\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1rem;\n}\n\n.contact-info > h4{\n    color: #fff;\n    font-weight: 600;\n    font-size: 0.9375rem;\n    font-family: Lato, sans-serif;\n}\n\n.footer-contact-info-wrapper{\n    padding: 3rem 0;\n\n    display: flex;\n    align-items: start;\n    gap: 3.5rem;\n}\n\n.contact-info{\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.contact-info-email{\n    color: #C9D3DC;\n    font-size: 1rem;\n\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n}\n\n.contact-info-email > a{\n    color: #C9D3DC;\n    font-weight: 500;\n    font-size: 0.875rem;\n}\n\n.footer-links{\n    padding: 1.875rem 0;\n    border-top: 1px solid #2C3B48;\n    border-bottom: 1px solid #2C3B48;\n}\n\n.footer-links > ul{\n    display: flex;\n    justify-content: center;\n    gap: 2rem;\n}\n\n.footer-links a{\n    color: #C9D3DC;\n    font-family: Lato, sans-serif;\n}\n\n.footer-copyright{\n    padding: 1rem 0;\n    display: flex;\n    justify-content: space-between;\n}\n\n.policy-container{\n    display: flex;\n    gap: 1.5rem;\n}\n\n.policy-container > a{\n    color: #C9D3DC;\n    font-family: Poppins, sans-serif;;\n}\n\n.copyright{\n    color: #8699A9;\n    font-weight: 600;\n    font-size: 0.75rem;\n}\n\n@media screen and (max-width: 1220px) {\n   /* .footer-container{\n    padding: 0 1rem;\n   } */\n}\n\n@media screen and (max-width: 1060px) {\n    .footer-contact-info-wrapper{\n     flex-direction: column;\n    }\n\n    .footer-links > ul{\n        flex-direction: column;\n    }\n\n    .footer-copyright{\n        flex-direction: column;\n    }\n\n    .policy-container{\n        flex-direction: column;\n    }\n\n    .copyright-container{\n        padding-top: 2rem;\n        padding-bottom: 5.6rem;\n    }\n }"
